{
  "Version": "2012-10-17",
  "Statement": [
    {"Effect": "Allow", "Action": ["iot:DescribeThing", "iot:GetThingShadow", "iot:UpdateThingShadow"], "Resource": [
      "arn:aws:iot:us-east-2:679937333206:thing/thing",
      "arn:aws:iot:us-east-2:679937333206:thing/ambientador-dos"
    ]},
    {"Effect": "Allow", "Action": ["dynamodb:GetItem", "dynamodb:PutItem", "dynamodb:DeleteItem"], "Resource": "arn:aws:dynamodb:us-east-2:679937333206:table/AmbientadorVinculaciones"},
